# Copy to `.env.local` for local overrides. Leave unset to use local (device) auth/progress.

# Firebase Auth (optional) — enables Google + cloud email accounts
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# Stripe checkout via your backend (optional)
# POST body: { userId, priceId?, bookId?, successUrl, cancelUrl }
# Response JSON: { url: "https://checkout.stripe.com/..." }
# VITE_BILLING_CHECKOUT_URL=
