{
  "hosting": {
    "public": "dist/book_html",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=86400,must-revalidate"
          }
        ]
      },
      {
        "source": "/**/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=2592000,must-revalidate"
          }
        ]
      }
    ]
  }
}
